[Unit]
Description=Isolated feature selection channel

[Socket]
ListenStream=/opt/var/lib/consent-feature-runtime/argo.sock
SocketUser=root
SocketGroup=users
SocketMode=0660
DirectoryMode=0755
Accept=no
Service=consent-feature-poc.service
Backlog=8
RemoveOnStop=yes
