[Unit]
Description=Isolated argo feature selection coordinator
Requires=consent-feature-poc.socket consentd-poc.socket
After=consent-feature-poc.socket consentd-poc.socket

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/consent/poc/consent-mock-argo feature-serve
User=root
Group=root
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_PTRACE
SmackProcessLabel=System
Sockets=consent-feature-poc.socket
UMask=0077
Restart=no
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=consent-feature-poc
NoNewPrivileges=yes
