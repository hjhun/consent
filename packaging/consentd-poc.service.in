[Unit]
Description=Isolated consent development daemon
Requires=consentd-poc.socket
After=consentd-poc.socket

[Service]
Type=notify
NotifyAccess=main
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/consent/poc/consentd-poc
ExecStartPre=+@CMAKE_INSTALL_FULL_LIBEXECDIR@/consent/poc/consent-storage-prepare-poc
User=@CONSENT_SERVICE_USER@
Group=@CONSENT_SERVICE_USER@
AmbientCapabilities=CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_SYS_PTRACE
SmackProcessLabel=System
Sockets=consentd-poc.socket
UMask=0077
Restart=on-failure
RestartSec=1s
TimeoutStartSec=15s
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=consentd-poc
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
