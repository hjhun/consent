prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CONSENT_PC_LIBDIR@
includedir=@CONSENT_PC_INCLUDEDIR@

Name: consent
Description: Tizen user consent client C API
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lconsent
Cflags: -I${includedir}/consent
